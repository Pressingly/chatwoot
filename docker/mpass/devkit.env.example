# Append to the mpass-sso-devkit's .env: docker-compose.devkit.yml runs inside the devkit's
# compose project, so it reads the devkit's .env.

# --- Already in the devkit's .env; Chatwoot uses them as they are ---
# PLATFORM_DOMAIN=foss.local.dev
# DEFAULT_EMAIL_DOMAIN=askii.ai   (required: the devkit sends a bare mPass id)
# SMB_CORPORATE_ID=
# OIDC_BASE_URI=...       (the Cognito issuer; verifies the token when SMB_CORPORATE_ID is set)
# OIDC_CLIENT_ID=...
# SESSION_COOKIE_MAX_AGE_SECONDS=432000

# --- Chatwoot ---
# openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME
CHATWOOT_POSTGRES_PASSWORD=CHANGE_ME
# Required for SSO: openssl rand -hex 32 (at least 32 characters)
CHATWOOT_EDGE_SECRET=CHANGE_ME
