# Copy to docker/mpass/.env (gitignored, kept out of the image) for docker-compose.devkit.yml.

# --- Same values as the running mpass-sso-devkit's .env ---
PLATFORM_DOMAIN=foss.local.dev
SMB_NAME=foss
DEFAULT_EMAIL_DOMAIN=
SESSION_TTL_SECONDS=432000

# --- Chatwoot ---
# openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME
CHATWOOT_POSTGRES_PASSWORD=CHANGE_ME
